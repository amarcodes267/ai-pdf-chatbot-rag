# ==================================================
# AI PDF Chatbot (RAG) — Environment Variables
# ==================================================
# Copy this file to `.env` (or set these variables in
# your environment) to configure the application.

# OPTIONAL — OpenAI API key for LLM-generated answers.
# When omitted, the app falls back to a local summary.
OPENAI_API_KEY=

# OPTIONAL — Override the OpenAI chat model used for answers.
# OPENAI_MODEL=gpt-3.5-turbo

